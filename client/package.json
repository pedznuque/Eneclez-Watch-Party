{
  "name": "eneclez-watch-party",
  "productName": "Eneclez Watch Party",
  "version": "1.0.23",
  "description": "A private desktop watch party app for shared viewing and chat.",
  "author": "Gerald Nuque",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/torrent-service.test.cjs test/torrent-controls.test.cjs test/torrent-panel.test.cjs test/torrent-recovery.test.cjs test/torrent-readiness.test.cjs test/torrent-sharing.test.cjs test/fullscreen-controls.test.cjs test/server-rooms.test.cjs test/cloud-cache.test.cjs test/webtor-native.test.cjs",
    "test:ui": "electron test/app-ui.electron.cjs",
    "test:room": "electron test/room-viewers.electron.cjs",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --publish never",
    "test:cloud": "electron test/cloud-viewers.electron.cjs"
  },
  "build": {
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "appId": "com.eneclez.watchparty",
    "productName": "Eneclez Watch Party",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pedznuque",
        "repo": "Eneclez-Watch-Party"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "torrent-service.cjs",
      "package.json",
      "src/**/*"
    ],
    "win": {
      "icon": "src/assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Eneclez-Watch-Party-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "src/assets/app-icon.ico",
      "uninstallerIcon": "src/assets/app-icon.ico",
      "shortcutName": "Eneclez Watch Party"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "webtorrent": "^3.0.21"
  }
}
